# ASR
ASR_MODEL_ID=FarmerlineML/w2v-bert-2.0_kamba
ASR_TARGET_LANG=kam
MAX_AUDIO_SECONDS=60
SAMPLE_RATE=16000

# Translation
# TRANSLATION_BACKEND: "nllb" (default) runs Meta's NLLB-200 locally, free,
# no API key -- good for getting started. "anthropic" uses the Anthropic API
# for LLM-based translation instead (needs the two vars below); check
# https://docs.claude.com for the current model identifier.
TRANSLATION_BACKEND=nllb
NLLB_MODEL_ID=facebook/nllb-200-distilled-600M
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=

# Server
UPLOAD_MAX_MB=25
MAX_TRANSLATE_CHARS=500
# TEMP_DIR defaults to <system temp>/kam-backend; set it only to override.
# TEMP_DIR=

# Text-to-speech: Meta's Swahili voice reading Kikamba (see app/tts.py)
TTS_MODEL_ID=facebook/mms-tts-swh

# Voice-recording contributions (see app/voice.py). Set VOICE_DATASET_REPO (and
# HF_TOKEN with write access) to push recordings to a private HF dataset;
# empty keeps them in data/voice only.
VOICE_DATASET_REPO=
VOICE_MAX_SECONDS=20
