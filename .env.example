# ASR
ASR_MODEL_ID=facebook/mms-1b-all
ASR_TARGET_LANG=kam
MAX_AUDIO_SECONDS=60
SAMPLE_RATE=16000

# Translation (Anthropic API) -- check https://docs.claude.com for the
# current model identifier before setting this.
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=

# Server
UPLOAD_MAX_MB=25
TEMP_DIR=/tmp/kam-backend
